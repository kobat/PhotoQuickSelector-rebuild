<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>PhotoQuickSelector_App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</RuntimeIdentifier>
    <PublishProfile Condition="Exists('Properties\PublishProfiles\win-$(Platform).pubxml')">win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <EnableMsixTooling>true</EnableMsixTooling>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!--
      バージョン情報ダイアログがリフレクションで参照する単一情報源（ハードコード排除）。
      開発中は SemVer のプレリリース表記 `-dev` を付け、リリースのコミットで外す
      （Package.appxmanifest の Version は数値4組しか許されないので、そちらは数値のみ上げる）。
      `-dev` が残るのは AssemblyInformationalVersion だけ（AssemblyVersion/FileVersion は数値部のみ）。
    -->
    <Version>0.2.2-dev</Version>
    <!-- InformationalVersion への `+<git sha>` 付与を止める（そのまま画面に出すため）。 -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Assets\SplashScreen.scale-200.png" />
    <Content Include="Assets\LockScreenLogo.scale-200.png" />
    <Content Include="Assets\Square150x150Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.scale-200.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-24_altform-unplated.png" />
    <Content Include="Assets\Square44x44Logo.targetsize-48_altform-lightunplated.png" />
    <Content Include="Assets\StoreLogo.png" />
    <Content Include="Assets\AppIcon.ico" />
    <Content Include="Assets\Wide310x150Logo.scale-200.png" />
  </ItemGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    プレビュー先読みが LOH 行きの巨大 byte[]（圧縮バイト＋BGRA ピクセル）を毎回確保するため、
    既定の GC だとゴミ滞留と decommit の先送りでコミット/ワーキングセットがライブ量の倍近くまで育つ。
    ConserveMemory（1〜9・大きいほどスループットを犠牲にメモリ優先）で LOH 圧縮と OS への返却を
    平時から積極化する。7 は実機測定（2026-07-31・M オーバーレイの Committed/WS）で決めた値＝
    5 は効果不足・9 は GC 停止が体感に出る・7 が効果と挙動のバランス良。
  -->
  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="7" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-project MSIX Packaging
    Tools extension to be activated for this project even if the Windows App SDK Nuget
    package has not yet been restored.
  -->
  <ItemGroup Condition="'$(DisableMsixProjectCapabilityAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <ProjectCapability Include="Msix" />
  </ItemGroup>

  <!--
    Microsoft.Windows.SDK.BuildTools.WinApp adds first-class support for
    `dotnet run` on packaged WinUI apps: it hooks the .NET CLI Run target to
    register a debug identity via the winapp CLI and launch the app with
    package identity (AUMID).
    Set <EnableWinAppRunSupport>false</EnableWinAppRunSupport> in a
    <PropertyGroup> above to opt out.
  -->
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.WinUI.Controls.Sizers" Version="8.2.251219" />
    <PackageReference Include="Microsoft.Graphics.Win2D" Version="1.4.0" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.1839" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.2.0" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools.WinApp" Version="0.3.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PhotoQuickSelector.Core\PhotoQuickSelector.Core.csproj" />
  </ItemGroup>

  <!--
    配布物にライセンス文を同梱する（出力/発行ディレクトリ直下へコピー）。
    LICENSE        … 本アプリ（MIT）／THIRD-PARTY-NOTICES.txt … 同梱する第三者ライブラリの許諾。
    リポジトリ直下の実体を Link で出力ルートに配置する。
  -->
  <ItemGroup>
    <Content Include="..\..\LICENSE" Link="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\THIRD-PARTY-NOTICES.txt" Link="THIRD-PARTY-NOTICES.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <!--
    バージョン情報→ライセンス画面がアプリ内で表示するためにアセンブリへ埋め込む。
    single-file 発行でも exe 隣のファイル有無に依存せず確実に読み出せる（GetManifestResourceStream）。
    上の Content（配布物への同梱＝法的要件）とは別に二重で持つ。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\LICENSE" LogicalName="LICENSE" />
    <EmbeddedResource Include="..\..\THIRD-PARTY-NOTICES.txt" LogicalName="THIRD-PARTY-NOTICES.txt" />
  </ItemGroup>

  <!--
    ショートカット一覧の唯一の情報源（SSOT）。アプリ内 F1（ShortcutCheatSheet）が実行時にパースして表示する。
    ドキュメント docs/SHORTCUTS.md も同ファイルから tools/gen-shortcuts.ps1 で生成する。
    single-file 発行でも exe 隣のファイル有無に依存せず読める（GetManifestResourceStream）。
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\shortcuts.json" LogicalName="shortcuts.json" />
  </ItemGroup>

  <!--
    EnableMsixTooling=true の下では Content の CopyToPublishDirectory が publish 出力へ反映されない
    （WinAppSDK/MSIX 側の publish パイプラインが ResolvedFileToPublish を独自に計算するため）。
    dotnet publish（フォルダ／単一ファイルいずれも）の後に確実に配置する。
  -->
  <Target Name="CopyLicenseFilesToPublishDir" AfterTargets="Publish">
    <Copy SourceFiles="..\..\LICENSE;..\..\THIRD-PARTY-NOTICES.txt" DestinationFolder="$(PublishDir)" SkipUnchangedFiles="true" />
  </Target>

  <!--
    Defining the "HasPackageAndPublishMenuAddedByProject" property here allows the Solution
    Explorer "Package and Publish" context menu entry to be enabled for this project even if
    the Windows App SDK Nuget package has not yet been restored.
  -->
  <PropertyGroup Condition="'$(DisableHasPackageAndPublishMenuAddedByProject)'!='true' and '$(EnableMsixTooling)'=='true'">
    <HasPackageAndPublishMenu>true</HasPackageAndPublishMenu>
  </PropertyGroup>

  <!-- Publish Properties -->
  <PropertyGroup>
    <PublishReadyToRun Condition="'$(Configuration)' == 'Debug'">False</PublishReadyToRun>
    <PublishReadyToRun Condition="'$(Configuration)' != 'Debug'">True</PublishReadyToRun>
    <!--
      WinUI 3 / Win2D はトリミング非対応のため常に無効。
      （SPEC §0：トリミングすると XAML/Win2D が実行時に壊れる）
    -->
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>
