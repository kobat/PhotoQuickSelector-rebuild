<?xml version="1.0" encoding="utf-8" ?>
<UserControl
    x:Class="PhotoQuickSelector_App.Controls.EmptyStateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <!-- グリッドに写真を出せないときの空状態（アイコン＋1 行）。件数・絞り込み条件はフィルタボタンと
         重複するため出さない。理由の出し分けは MainViewModel.EmptyState* が担う。
         クリックは下のグリッドへ透過させる（IsHitTestVisible=False）。 -->
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center"
                IsHitTestVisible="False"
                Visibility="{x:Bind ViewModel.EmptyStateVisibility, Mode=OneWay}">

        <!-- 「〜が無い」を示す斜線はグリフに重ねて描く（Segoe Fluent Icons に斜線入りの
             フィルタ／写真グリフが無いため）。座標はアイコンの外接 48px 正方形基準。 -->
        <Grid Width="48" Height="48" HorizontalAlignment="Center">
            <FontIcon FontSize="48"
                      Glyph="{x:Bind ViewModel.EmptyStateGlyph, Mode=OneWay}"
                      Foreground="{ThemeResource TextFillColorTertiaryBrush}" />
            <Path Data="M 7,41 L 41,7"
                  Stroke="{ThemeResource TextFillColorTertiaryBrush}" StrokeThickness="3"
                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                  Visibility="{x:Bind ViewModel.EmptyStateSlashVisibility, Mode=OneWay}" />
        </Grid>

        <!-- エラーではなく状態なので、太字にはせず二次色で落ち着かせる。 -->
        <TextBlock Margin="0,20,0,0" MaxWidth="480"
                   HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                   Style="{ThemeResource SubtitleTextBlockStyle}" FontWeight="Normal"
                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                   Text="{x:Bind ViewModel.EmptyStateMessage, Mode=OneWay}" />
    </StackPanel>
</UserControl>
